@using Mladim.Client.Validators;
@using Mladim.Domain.Enums;
@using Mladim.Domain.Extensions;
@using Mladim.Domain.Models;



    <MudStack style="width:100%;"  Spacing="3" Justify="Justify.Center">    
        <MudForm style="min-width:80%; margin-left:auto; margin-right:auto;"  Model="@AnonymousYouthWorker" @ref=@form Validation="@(validator.ValidateValue)">
            <MudStack Spacing=3 Justify="Justify.Center">
                <MudSelect  @bind-Value="@AnonymousYouthWorker.Gender" For="@(() => AnonymousYouthWorker.Gender)" T="Gender" ToStringFunc="@(gender => gender.GetDisplayAttribute())" Variant="Variant.Outlined" Label="Spol" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var gender in Enum.GetValues<Gender>())
                        {
                            <MudSelectItem Value="gender">@gender.GetDisplayAttribute()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect @bind-Value="@AnonymousYouthWorker.AgeGroup" For="@(()=> AnonymousYouthWorker.AgeGroup)" T="AgeGroups" ToStringFunc="@(age => age.GetDisplayAttribute())" Variant="Variant.Outlined" Label="Starostna skupina" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var age in Enum.GetValues<AgeGroups>())
                        {
                            <MudSelectItem Value="age">@age.GetDisplayAttribute()</MudSelectItem>
                        }
                    </MudSelect>

                     <MudSelect @bind-Value="@AnonymousYouthWorker.Role" For="@(() => AnonymousYouthWorker.Role)" T="YouthWorkRole" ToStringFunc="@(role => role.GetDisplayAttribute())" Variant="Variant.Outlined" Label="Trenutna vloga" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var role in Enum.GetValues<YouthWorkRole>())
                        {
                            <MudSelectItem Value="role">@role.GetDisplayAttribute()</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect @bind-Value="@AnonymousYouthWorker.YearsOfExperience" For="@(() => AnonymousYouthWorker.YearsOfExperience)" T="YearsOfExperienceInYouthWork" ToStringFunc="@(experiences => experiences.GetDisplayAttribute())" Variant="Variant.Outlined" Label="Leta izkušenj z mladinskim delom" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var experience in Enum.GetValues<YearsOfExperienceInYouthWork>())
                        {
                             <MudSelectItem Value="experience">@experience.GetDisplayAttribute()</MudSelectItem>
                        }
                    </MudSelect>

            <MudButton Variant=Variant.Filled Color=Color.Primary OnClick="@ShowSurveyQuestions">Nadaljuj</MudButton>
            </MudStack>
        </MudForm>  
    </MudStack>


@code
{

    private AnonymousYouthWorkerVM AnonymousYouthWorker { get; set; } = new();

    [Parameter]
    public EventCallback<SurveyParticipantVM> AnonymousButton { get; set; }

    private AnonymousYouthWorkerValidator validator = new AnonymousYouthWorkerValidator();

    private MudForm form;

    private async Task ShowSurveyQuestions()
    {
        await form.Validate();

        if (form.IsValid && AnonymousButton.HasDelegate)
            await AnonymousButton.InvokeAsync(AnonymousYouthWorker);
    }

   
}
