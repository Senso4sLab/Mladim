@using Mladim.Client.ViewModels.Survey;
@using Mladim.Domain.Enums;
@using Syncfusion.Blazor.SplitButtons



<div>
    <MudText Typo="Typo.h2" Color="Color.Tertiary" Class="py-3">@SurveyQuestion.Header?.GetByGender(Gender)</MudText>

    @for (int i = 0; i < SurveyQuestion.Questions.Count; i++)
    {
        <ButtonQuestion SurveyQuestion="@SurveyQuestion.Questions[i].GetByGender(Gender)" SurveyResponse="@SurveyResponse.Response[i]" />
    }    
</div>

@code 
{
    [Parameter]
    public Gender Gender { get; set; }


    [Parameter]
    public SurveyQuestionVM SurveyQuestion { get; set; } = default!;

    [Parameter]
    public QuestionMultiButtonResponseVM SurveyResponse { get; set; } = default!;

    protected override void OnInitialized()
    {
        for (int i = 0; i < SurveyQuestion.Questions.Count; i++)
        {
            var response = new QuestionButtonResponseVM(SurveyQuestion.Id);
            SurveyResponse.AddResponse(response);
        }
    }

}
