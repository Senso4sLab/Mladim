@using Mladim.Client.Services.PopupService
@using Mladim.Client.Validators
@using Mladim.Domain.Models

<MudDialog style="min-width:600px; padding-top:80px; padding-bottom:80px; border-radius:10px;">
    <DialogContent>
        <MudForm @ref="@emailForm" Model="@userEmail" Validation="@(emailValidator.ValidateValue)" OnValidSubmit="OnValidSubmit">
            <MudStack Justify="Justify.Center" Spacing="2">

                <MudImage Src="logo.png" Height="50" style="margin: 40px auto;"></MudImage>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
                }

                <MudText Typo="Typo.h2">Pozabljeno geslo</MudText>

                <MudText Typo="Typo.h1">Za določitev novega gesla je potrebno vnesti e-mail naslov vašega Mladim uporabniškega računa. Na ta e-mail naslov vam bomo poslali povezavo, s pomočjo katere boste lahko določili novo geslo.</MudText>

                <MudTextField Label="Email"
                              @bind-Value="userEmail.Email" For="@(() => userEmail.Email)" Variant="Variant.Outlined" />



                <MudButton OnClick="@OnValidSubmit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isBusy" Class="my-5">

                    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.h6">Potrdi</MudText>
                        @if (_isBusy)
                        {
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        }
                    </MudStack>
                </MudButton>
            </MudStack>
        </MudForm>
    </DialogContent>
</MudDialog>

@code
{
    private bool _isBusy = false;
    private string _errorMessage = string.Empty;   
    private UserEmail userEmail = new UserEmail();

    private MudForm? emailForm;

    EmailValidator emailValidator = new EmailValidator();


    [Inject]
    public IAuthService AuthService{ get; set; }

    [Inject]
    protected NavigationManager Navigation { get; set; } 

    [Inject]
    public IPopupService PopupService { get; set; }

    public async Task OnValidSubmit()
    {
        this._errorMessage = string.Empty;

        await emailForm.Validate();

        if (!emailForm.IsValid)
            return;

        _isBusy = true;

        var response = await this.AuthService.ResetPasswordAsync(userEmail);      

        _isBusy = false;

        if (!response.Succeeded)
            this._errorMessage = response.Message;
        else
        {
            PopupService.ShowSnackbarSuccess("Vabilo je bilo uspešno poslano.");
            this.Navigation.NavigateTo("/login"); 
        }

    }
}

