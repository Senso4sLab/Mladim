@page "/newpassword/"
@using Mladim.Client.Validators
@using Mladim.Domain.Models
@layout AuthLayout

<PageTitle>Pozabljeno geslo</PageTitle>

<MudForm @ref="@passwordForm" Model="@newPassUser" Validation="@(validator.ValidateValue)" OnValidSubmit="OnValidSubmit">
    <MudStack Justify="Justify.Center" Spacing="2" style="width:500px;margin: 0px auto;">

        <MudImage Src="logo.png" style="width:250px; margin: 10px auto;"></MudImage>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled">@_errorMessage</MudAlert>
        }
        <MudText Typo="Typo.h2" Color="Color.Tertiary" style="margin: 10px auto;">Določitev novega gesla</MudText>
      
        <MudTextField Label="Email"
                      @bind-Value="newPassUser.Email" For="@(() => newPassUser.Email)" Variant="Variant.Outlined" />

        <MudTextField Label="Geslo"
                      @bind-Value="newPassUser.Password" For="@(() => newPassUser.Password)"
                      InputType="@PasswordInput" Variant="Variant.Outlined"
                      Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="ButtonPasswordClick" AdornmentAriaLabel="Pokaži geslo" />        


        <MudButton OnClick="@OnValidSubmit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_isBusy" Class="my-5">

            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Potrdi</MudText>
                @if (_isBusy)
                {
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                }
            </MudStack>
        </MudButton>

    </MudStack>
</MudForm>





@code 
{
    [Parameter]
    [SupplyParameterFromQuery]
    public string? PasswordId { get; set; }

    [Inject]
    public IAuthService AuthService{ get; set; }

    [Inject]
    public NavigationManager Navigation { get; set; }

    private MudForm passwordForm;

    private NewPasswordUser newPassUser = new NewPasswordUser();
    private NewPasswordUserValidator validator = new NewPasswordUserValidator();
    private bool _isBusy = false;
    private string _errorMessage = string.Empty;

    bool isShowPasword;
    private InputType PasswordInput = InputType.Password;
    private string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    bool isShowConfirmPasword;
    private InputType ConfirmPasswordInput = InputType.Password;
    private string ConfirmPasswordInputIcon = Icons.Material.Filled.VisibilityOff;    

    public async Task OnValidSubmit()
    {
        this._errorMessage = string.Empty;

        await passwordForm.Validate();

        if (!passwordForm.IsValid)
            return;

        _isBusy = true;

        newPassUser.Token = PasswordId?.Replace(' ', '+');
        var response = await this.AuthService.ConfirmResetPasswordAsync(newPassUser);       

        if(!response.Succeeded)
        {
            this._errorMessage = response.Message;
            _isBusy = false;
            return;
        }

        var authResponse = await this.AuthService.LoginAsync(new LoginUser { Email = newPassUser.Email, Password = newPassUser.Password });

        if (authResponse.Succeeded)        
            this.Navigation.NavigateTo("/organization");        
        else        
            this._errorMessage = response.Message;        

        _isBusy = false;
    }


    public void ButtonPasswordClick()
    {
        if (isShowPasword)
        {
            isShowPasword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShowPasword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

    public void ButtonConfirmPasswordClick()
    {
        if (isShowConfirmPasword)
        {
            isShowConfirmPasword = false;
            ConfirmPasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            ConfirmPasswordInput = InputType.Password;
        }
        else
        {
            isShowConfirmPasword = true;
            ConfirmPasswordInputIcon = Icons.Material.Filled.Visibility;
            ConfirmPasswordInput = InputType.Text;
        }
    }

}
